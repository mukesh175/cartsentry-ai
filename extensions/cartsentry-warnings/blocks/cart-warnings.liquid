{% comment %}
  CartSentry AI — cart warning block.

  Shows the merchant's configured warning before the customer reaches checkout.
  Enforcement happens server-side in the validation function regardless of this
  block; this is the early, friendlier heads-up.

  Performance notes (see docs/ARCHITECTURE.md):
    - no framework, no bundler output, no analytics; one small inline script
    - the rule configuration is fetched once per page from the app proxy and
      cached in sessionStorage, so navigating the store does not re-fetch
    - nothing renders and no space is reserved until a rule actually matches
{% endcomment %}

<div
  class="cartsentry-warnings"
  data-cartsentry
  data-context="cart"
  data-proxy="{{ shop.url }}/apps/cartsentry/warnings"
  hidden
>
  <div class="cartsentry-warnings__list" role="status" aria-live="polite"></div>
</div>

{{ 'cartsentry-warnings.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cartsentry-warnings.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CartSentry warnings",
  "target": "section",
  "stylesheet": "cartsentry-warnings.css",
  "javascript": "cartsentry-warnings.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a warning in the cart when the customer's cart breaks one of your CartSentry purchase rules. Your rules are always enforced at checkout, whether or not this block is added."
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you check out"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Appearance",
      "options": [
        { "value": "banner", "label": "Banner" },
        { "value": "inline", "label": "Inline text" }
      ],
      "default": "banner"
    }
  ]
}
{% endschema %}
