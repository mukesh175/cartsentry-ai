{
  "include": [
    "env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "types": [
      "@react-router/node",
      "vite/client",
      "@shopify/polaris-types"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@cartsentry/engine": [
        "./packages/engine/src/index.ts"
      ],
      "@cartsentry/engine/*": [
        "./packages/engine/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "build",
    "extensions/*/dist"
  ]
}
