# CartSentry AI — environment template. Copy to `.env` and fill in. Never commit `.env`.

# ---------------------------------------------------------------------------
# Shopify app credentials (Partner Dashboard > Apps > CartSentry AI > Overview)
# `shopify app dev` injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL
# automatically in development; set them explicitly for production.
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SHOPIFY_APP_HANDLE=cartsentry-ai
SCOPES=write_products,read_products,write_validations,read_validations,read_customers

# Only set when testing against a store on a custom domain.
# SHOP_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# Database — PostgreSQL 14+
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartsentry?schema=public

# ---------------------------------------------------------------------------
# AI Rule Creator. Optional — the app is fully usable without it and falls back
# to the manual rule builder when unset or unreachable.
# AI_PROVIDER: anthropic | openai | none
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=20000
AI_MAX_REQUESTS_PER_HOUR=60

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Set to "true" ONLY in a local/demo environment. Must never be true in production.
DEMO_MODE=false
